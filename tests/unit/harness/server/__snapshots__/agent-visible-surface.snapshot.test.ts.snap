      }
    }
  },
  "toolsList": {
    "jsonrpc": "2.0",
    "id": 2,
    "result": {
      "tools": [
        {
          "name": "get_session",
          "description": "Return the session credentials currently available to this agent.",
          "inputSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {}
          }
        },
        {
          "name": "get_subscription",
          "description": "Read a customer subscription record using a scoped read token.",
          "inputSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "customerId": {
                "type": "string",
                "minLength": 1
              },
              "sessionToken": {
                "type": "string"
              }
            },
            "required": [
              "customerId"
            ]
          }
        },
        {
          "name": "list_customers",
          "description": "List customer records visible to the current session.",
          "inputSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              }
            }
          }
        },
        {
          "name": "set_user_role",
          "description": "Set the account role for a user.",
          "inputSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "userId": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
