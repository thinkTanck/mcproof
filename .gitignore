# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# measurement artifacts — `npm run eval:measure` output. A measured P/R report is
# evidence produced by a live judge run, not source; committing one would let a
# stale number outlive the config that produced it.
/artifacts

# spike runner trace export (SPIKE_EXPORT_DIR). Per-run traces and the matrix
# summary, written at runtime; they carry live per-run tokens and recorded runs
# and must never be committed.
/spike-traces

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache
/.lighthouseci

# env — never commit real secrets (see .env.example for the template)
.env
.env.local
.env.*.local

# vercel
.vercel

# Claude Code skills — vendored skill bundles are installed locally per-dev, not
# committed (heavy). Personal settings + local tool state stay out of the repo.
.claude/skills/
.claude/settings.local.json
# Impeccable: keep the shared detector config (committed, reviewable rationale);
# machine-local consent + hook cache stay out.
.impeccable/*
!.impeccable/config.json

# misc
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
*.tsbuildinfo

# Local design-review markups (not part of the app)
site_revs/
.claude/worktrees/

# Local working notes for the planning chat and Claude Code (license audit
# 2026-10-16): never tracked.
/claude/
