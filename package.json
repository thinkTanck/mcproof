{
  "name": "mcpwn",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Red-team your MCP agents against the OWASP Top 10 for Agentic Applications (2026) — live attack replay, per-model robustness leaderboard, engineer-ready fix reports.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test",
    "audit": "audit-ci --config ./audit-ci.json",
    "db:link": "supabase link --project-ref ovsznqyynlxhrdnfywjx",
    "db:new": "supabase migration new",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "prepare": "husky",
    "eval:measure": "tsx scripts/eval-measure.ts",
    "eval:measure-category": "tsx scripts/eval-measure-category.ts",
    "serve:mcp": "tsx scripts/server/serve.ts",
    "verify:durable-stores": "tsx scripts/verify-durable-stores.ts",
    "verify:https-accept": "tsx --env-file=.env.local scripts/verify-https-accept.ts",
    "spike:cell": "tsx --env-file=.env.local scripts/spike/run.ts cell",
    "spike:matrix": "tsx --env-file=.env.local scripts/spike/run.ts matrix"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.3.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.11",
    "audit-ci": "7.1.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.7",
    "fast-check": "4.9.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "16.4.0",
    "prettier": "3.9.4",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.4",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "tmp": "^0.2.4",
    "sharp": "0.35.5",
    "fast-uri": "3.1.8",
    "postcss": "8.5.28",
    "undici": "7.29.1",
    "ip-address": "10.7.2",
    "nanoid": "3.3.18",
    "js-yaml": "4.3.2",
    "@lhci/cli": {
      "js-yaml": "3.15.2",
      "uuid": "11.1.1"
    },
    "qs": "6.16.0",
    "minimatch@^3": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@^10": {
      "brace-expansion": "5.0.12"
    },
    "basic-ftp": "6.2.1"
  }
}
